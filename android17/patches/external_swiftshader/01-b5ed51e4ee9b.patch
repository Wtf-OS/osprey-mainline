From: MrBoombastic <contact@amroz.xyz>
Date: Fri, 9 Oct 2026 14:28:05 +0200
Subject: [PATCH] fix(mainline): support BGRA buffers in software Vulkan
 fallback

Change-Id: I1cfc6474822630789c834c98e68d401fbb105af6
(cherry picked from commit 91b09a516172fa7016653e82ef3afebf18b360d4)
---
 src/Vulkan/VkDeviceMemoryExternalAndroid.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/Vulkan/VkDeviceMemoryExternalAndroid.cpp b/src/Vulkan/VkDeviceMemoryExternalAndroid.cpp
index b7cdd0d..f0c6837 100644
--- a/src/Vulkan/VkDeviceMemoryExternalAndroid.cpp
+++ b/src/Vulkan/VkDeviceMemoryExternalAndroid.cpp
@@ -14,6 +14,8 @@
 
 #include "VkDeviceMemoryExternalAndroid.hpp"
 
+#include <system/graphics.h>
+
 #include "VkDestroy.hpp"
 #include "VkFormat.hpp"
 #include "VkObject.hpp"
@@ -27,6 +29,8 @@ uint32_t GetAHBFormatFromVkFormat(VkFormat format)
 {
 	switch(format)
 	{
+	case VK_FORMAT_B8G8R8A8_UNORM:
+		return HAL_PIXEL_FORMAT_BGRA_8888;
 	case VK_FORMAT_D16_UNORM:
 		return AHARDWAREBUFFER_FORMAT_D16_UNORM;
 	case VK_FORMAT_X8_D24_UNORM_PACK32:
@@ -355,6 +359,8 @@ VkFormat AHardwareBufferExternalMemory::GetVkFormatFromAHBFormat(uint32_t ahbFor
 {
 	switch(ahbFormat)
 	{
+	case HAL_PIXEL_FORMAT_BGRA_8888:
+		return VK_FORMAT_B8G8R8A8_UNORM;
 	case AHARDWAREBUFFER_FORMAT_BLOB:
 		return VK_FORMAT_UNDEFINED;
 	case AHARDWAREBUFFER_FORMAT_D16_UNORM:
