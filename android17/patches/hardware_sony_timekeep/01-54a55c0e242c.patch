From 54a55c0e242cbe532025a27b895dffe02dbe79d6 Mon Sep 17 00:00:00 2001
From: MrBoombastic <contact@amroz.xyz>
Date: Tue, 20 Oct 2026 16:57:20 +0200
Subject: [PATCH] fix(selinux): align TimeKeep domains with Android 17

---
 sepolicy/vendor/file_contexts          | 2 ++
 sepolicy/vendor/seapp_contexts         | 2 +-
 sepolicy/vendor/vendor_timekeep.te     | 5 +++--
 sepolicy/vendor/vendor_timekeep_app.te | 2 --
 4 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index 9f85b63..687464f 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -1 +1,3 @@
 /(vendor|system/vendor)/bin/timekeep u:object_r:vendor_timekeep_exec:s0
+
+/data/vendor/time(/.*)? u:object_r:vendor_timekeep_data_file:s0
diff --git a/sepolicy/vendor/seapp_contexts b/sepolicy/vendor/seapp_contexts
index f0e9bc8..556e19e 100644
--- a/sepolicy/vendor/seapp_contexts
+++ b/sepolicy/vendor/seapp_contexts
@@ -1 +1 @@
-user=system seinfo=platform name=com.sony.timekeep domain=vendor_timekeep_app
+user=_app seinfo=platform name=com.sony.timekeep domain=vendor_timekeep_app type=app_data_file levelFrom=user
diff --git a/sepolicy/vendor/vendor_timekeep.te b/sepolicy/vendor/vendor_timekeep.te
index 980f1d6..2082cce 100644
--- a/sepolicy/vendor/vendor_timekeep.te
+++ b/sepolicy/vendor/vendor_timekeep.te
@@ -1,3 +1,4 @@
+type vendor_timekeep_data_file, file_type, data_file_type;
 type vendor_timekeep, domain;
 type vendor_timekeep_exec, exec_type, vendor_file_type, file_type;
 
@@ -5,8 +6,8 @@ init_daemon_domain(vendor_timekeep)
 
 allow vendor_timekeep self:capability sys_time;
 
-allow vendor_timekeep vendor_time_data_file:dir rw_dir_perms;
-allow vendor_timekeep vendor_time_data_file:file create_file_perms;
+allow vendor_timekeep vendor_timekeep_data_file:dir rw_dir_perms;
+allow vendor_timekeep vendor_timekeep_data_file:file create_file_perms;
 
 r_dir_file(vendor_timekeep, sysfs_rtc)
 
diff --git a/sepolicy/vendor/vendor_timekeep_app.te b/sepolicy/vendor/vendor_timekeep_app.te
index c33953a..6657a52 100644
--- a/sepolicy/vendor/vendor_timekeep_app.te
+++ b/sepolicy/vendor/vendor_timekeep_app.te
@@ -4,8 +4,6 @@ app_domain(vendor_timekeep_app)
 
 allow vendor_timekeep_app activity_service:service_manager find;
 
-allow vendor_timekeep_app vendor_time_data_file:dir search;
-allow vendor_timekeep_app vendor_time_data_file:file create_file_perms;
 
 r_dir_file(vendor_timekeep_app, sysfs_rtc)
 
-- 
2.47.3

