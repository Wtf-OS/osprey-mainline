+    public static void broadcastNewPicture(Context context, final Uri uri) {
+        if (context == null || uri == null ||
+                !ContentResolver.SCHEME_CONTENT.equals(uri.getScheme())) {
+            return;
+        }
+        Context application = context.getApplicationContext();
+        final Context sender = application != null ? application : context;
+        final Runnable notification = new Runnable() {
+            @Override
+            public void run() {
+                Intent picture = new Intent(ACTION_NEW_PICTURE, uri);
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                    picture.addFlags(Intent.FLAG_RECEIVER_REGISTERED_ONLY);
+                }
+                try {
+                    sender.sendBroadcast(picture);
+                    // Retain the legacy camera-app signal for existing receivers.
+                    sender.sendBroadcast(new Intent("com.android.camera.NEW_PICTURE", uri));
+                } catch (SecurityException failure) {
+                    Log.w(TAG, "Could not announce the saved picture", failure);
+                }
+            }
+        };
+        // The file is already closed and published; external notification need not block saving.
+        try {
+            AsyncTask.THREAD_POOL_EXECUTOR.execute(notification);
+        } catch (RejectedExecutionException busy) {
+            notification.run();
+        }
     }
 
