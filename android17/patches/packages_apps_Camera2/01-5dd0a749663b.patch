diff --git a/jni/jpegutil.h b/jni/jpegutil.h
index a8066ed..391ba02 100644
--- a/jni/jpegutil.h
+++ b/jni/jpegutil.h
@@ -18,6 +18,7 @@
 #include "math.h"
 #include <array>
 #include <cassert>
+#include <cstring>
 #include <functional>
 #include <memory>
 #include <stdlib.h>
@@ -133,6 +134,7 @@ class RowIterator {
   // The length of a row, with padding to the next multiple of 64.
   int padded_row_length_;
   std::vector<unsigned char> buf_;
+  std::vector<unsigned char> strided_row_;
 };
 
 /**
@@ -175,6 +177,7 @@ jpegutil::RowIterator<ROWS>::RowIterator(Plane plane, Transform transform,
     : plane_(plane), transform_(transform) {
   padded_row_length_ = row_length;
   buf_ = std::vector<unsigned char>(row_length * ROWS);
+  strided_row_.resize(row_length * 2);
 }
 
 template <unsigned int ROWS>
@@ -195,7 +198,6 @@ const std::array<unsigned char*, ROWS> jpegutil::RowIterator<ROWS>::LoadAt(
 
     int output_width = padded_row_length_;
     output_width = min(output_width, transform_.output_width());
-    output_width = min(output_width, plane_.width);
 
     // Each row in the output image will be copied into buf_ by gathering pixels
     // along an axis-aligned line in the plane.
@@ -240,20 +242,29 @@ const std::array<unsigned char*, ROWS> jpegutil::RowIterator<ROWS>::LoadAt(
     }
 
     int outX = 0;
-    for (int idx = plane_start; idx >= min(plane_start, plane_end) &&
-                                    idx <= max(plane_start, plane_end);
-         idx += stride) {
-      buf_ptrs[i][outX] = plane_.data[idx];
-      outX++;
+    if (stride == 1) {
+      outX = plane_end - plane_start + 1;
+      std::memcpy(buf_ptrs[i], plane_.data + plane_start, outX);
+    } else if (stride == 2) {
+      outX = (plane_end - plane_start) / 2 + 1;
+      // Gather from cached memory; byte reads from gralloc's WC mapping are slow.
+      std::memcpy(strided_row_.data(), plane_.data + plane_start, (outX - 1) * 2 + 1);
+      for (int x = 0; x < outX; x++) {
+        buf_ptrs[i][x] = strided_row_[2 * x];
+      }
+    } else {
+      for (int idx = plane_start; idx >= min(plane_start, plane_end) &&
+                                      idx <= max(plane_start, plane_end);
+           idx += stride) {
+        buf_ptrs[i][outX++] = plane_.data[idx];
+      }
     }
 
     // Fill the remaining right-edge of the buffer by extending the last
     // value.
     unsigned char right_padding_value = buf_ptrs[i][outX - 1];
-    // TODO OPTIMIZE Use memset instead.
-    for (; outX < padded_row_length_; outX++) {
-      buf_ptrs[i][outX] = right_padding_value;
-    }
+    std::memset(buf_ptrs[i] + outX, right_padding_value,
+                padded_row_length_ - outX);
   }
 
   return buf_ptrs;
