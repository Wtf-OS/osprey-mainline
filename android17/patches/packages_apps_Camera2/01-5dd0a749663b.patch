 #include <setjmp.h>
 
@@ -269,7 +271,10 @@ int jpegutil::Compress(int img_width, int img_height,
   imgArr[1] = const_cast<JSAMPARRAY>(cbArr);
   imgArr[2] = const_cast<JSAMPARRAY>(crArr);
 
+  const auto encodeStart = std::chrono::steady_clock::now();
+  std::chrono::steady_clock::duration rowTime{};
   for (int y = 0; y < img_height; y += DCTSIZE * 2) {
+    const auto rowStart = std::chrono::steady_clock::now();
     std::array<unsigned char*, 16> yData = y_row_generator.LoadAt(y);
     std::array<unsigned char*, 8> cbData = cb_row_generator.LoadAt(y / 2);
     std::array<unsigned char*, 8> crData = cr_row_generator.LoadAt(y / 2);
@@ -282,10 +287,16 @@ int jpegutil::Compress(int img_width, int img_height,
       crArr[row] = crData[row];
     }
 
+    rowTime += std::chrono::steady_clock::now() - rowStart;
     jpeg_write_raw_data(&cinfo, imgArr, DCTSIZE * 2);
   }
 
   jpeg_finish_compress(&cinfo);
+  __android_log_print(ANDROID_LOG_INFO, "CameraJpegTiming",
+      "%dx%d rows=%lld us compress=%lld us", img_width, img_height,
+      static_cast<long long>(std::chrono::duration_cast<std::chrono::microseconds>(rowTime).count()),
+      static_cast<long long>(std::chrono::duration_cast<std::chrono::microseconds>(
