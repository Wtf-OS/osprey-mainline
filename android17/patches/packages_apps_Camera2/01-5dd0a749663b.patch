+    private void writeJpeg(Uri uri, ExifInterface exif, byte[] jpeg, int width,
+            int height, int orientation, ContentResolver resolver) throws IOException {
+        // Preserve the encoded image instead of decoding and recompressing it.
+        try (OutputStream os = resolver.openOutputStream(uri, "w")) {
+            if (os == null) throw new IOException("Could not open image output");
+            if (exif != null) exif.writeExif(jpeg, os);
+            else os.write(jpeg);
+        }
+        ContentValues values = new ContentValues();
+        values.put(Media.WIDTH, width);
+        values.put(Media.HEIGHT, height);
+        values.put(Media.ORIENTATION, orientation);
+        values.put(Media.IS_PENDING, 0);
+        if (resolver.update(uri, values, null, null) != 1) {
+            throw new IOException("Could not publish saved image");
+        }
+    }
