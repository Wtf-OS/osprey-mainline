
service mainline-camera-provider /data/camera-runtime/bin/android.hardware.camera.provider@2.4-service
    class hal
    user cameraserver
    group camera audio input drmrpc
    seclabel u:r:hal_camera_default:s0
    setenv LD_LIBRARY_PATH /data/camera-runtime/lib:/data/graphics-libs:/system/lib:/system/lib/bootstrap:/vendor/lib
    setenv LIBCAMERA_LOG_LEVELS *:INFO
    disabled

service mainline-swcodec /apex/com.android.media.swcodec/bin/mediaswcodec
    user mediacodec
    group camera drmrpc mediadrm
    seclabel u:r:mediacodec:s0
    setenv LD_LIBRARY_PATH /data/graphics-libs:/system/lib:/system/lib/bootstrap:/vendor/lib:/apex/com.android.media.swcodec/lib
    disabled

service mainline-cameraserver /system/bin/cameraserver
    class main
    user cameraserver
    group camera audio input drmrpc
    seclabel u:r:cameraserver:s0
    setenv LD_LIBRARY_PATH /data/graphics-libs:/system/lib:/system/lib/bootstrap:/vendor/lib
    disabled
