
service mainline-vndservicemanager /sbin/sh /data/run-vndservicemanager.sh
    user root
    group root
    seclabel u:r:vndservicemanager:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled

service mainline-configstore /sbin/sh /data/run-configstore.sh
    user root
    group root
    seclabel u:r:hal_configstore_default:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled

service mainline-composer /sbin/sh /data/run-native-composer.sh
    user root
    group root
    seclabel u:r:hal_graphics_composer_default:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled

service mainline-allocator /sbin/sh /data/run-allocator.sh
    user root
    group root
    seclabel u:r:hal_graphics_allocator_default:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled

service mainline-surfaceflinger /sbin/sh /data/run-surfaceflinger.sh
    user root
    group root
    seclabel u:r:surfaceflinger:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled

service mainline-bootanimation /sbin/sh /data/run-bootanimation.sh
    user root
    group root
    seclabel u:r:bootanim:s0
    setenv LD_LIBRARY_PATH /sbin
    setenv PATH /sbin
    disabled
    oneshot
