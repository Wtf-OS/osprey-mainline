on property:debug.mainline.wifi_ready=1
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0755 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    restorecon_recursive /data/vendor/wifi
    start wificond
    start vendor.wifi_hal_legacy

service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi-service
    interface aidl android.hardware.wifi.IWifi/default
    class hal
    user wifi
    group wifi gps
    capabilities NET_ADMIN NET_RAW SYS_MODULE
    seclabel u:r:hal_wifi_default:s0
    setenv LD_LIBRARY_PATH /probe-bin:/data/graphics-libs:/system/lib:/system/lib/bootstrap:/vendor/lib
    disabled

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -O/data/vendor/wifi/wpa/sockets -dd -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    class main
    socket wpa_wlan0 dgram 0660 wifi wifi
    user root
    seclabel u:r:hal_wifi_supplicant_default:s0
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/bootstrap:/vendor/lib
    disabled
    oneshot

service wificond /system/bin/wificond
    class main
    user wifi
    group wifi net_raw net_admin
    capabilities NET_RAW NET_ADMIN
    seclabel u:r:wificond:s0
    setenv LD_LIBRARY_PATH /system/lib:/system/lib/bootstrap
    disabled
